# Stratum MCP server — environment template
#
# Copy to `.env.mcp` (or export directly) and adjust. Every variable is read by
# the server (see crates/pkm-mcp/src/config.rs). Variables marked [optional]
# have secure defaults; the rest are required for a remote deployment.

# ---- REQUIRED ----
# Path to the Stratum vault inside the container. The container mounts the
# host vault READ-ONLY here. The server expects `.pkm/blocks.db` under it
# (a vault the desktop app has opened) and `.pkm/config.toml` if present.
PKM_MCP_VAULT=/vault

# ---- TRANSPORT / BIND ----
# Transport served by the process. `http` is the only supported mode in the
# container image (stdio is for same-host single clients like Claude Desktop).
# Allowed: stdio|http|both. Default: stdio.
PKM_MCP_TRANSPORT=http
# Bind address. 0.0.0.0 is required inside Docker so the published port is
# reachable; health probes and the /mcp endpoint share this listener.
PKM_MCP_BIND=0.0.0.0:8787

# ---- AUTHENTICATION ----
# Authorization is optional (no-auth mode is for loopback/trusted networks).
# Remote deployments MUST set one of the two below. When set, the server
# requires a valid Bearer token (contract §7) and enforces per-token scopes.
# PKM_MCP_TOKEN is a single plaintext PAT; PKM_MCP_TOKEN_FILE points to a file
# of PATs, one per line (`token[:comma-separated-scopes]`).
# Prefer the file in production; mount it read-only.
#PKM_MCP_TOKEN=sk-stratum-0123456789abcdef0123456789abcdef
#PKM_MCP_TOKEN_FILE=/run/secrets/pkm_mcp_tokens

# ---- RATE LIMITING (HTTP transport only) ----
# Token-bucket limits (contract §9). Defaults: burst 60, rps 10.
#PKM_MCP_RATE_LIMIT_BURST=60
#PKM_MCP_RATE_LIMIT_RPS=10

# ---- HOST ALLOWLIST (Streamable HTTP) ----
# Allowed `Host` headers; reject others. Default "127.0.0.1,localhost".
# Set to your public hostname when serving remotely.
#PKM_MCP_ALLOWED_HOSTS=127.0.0.1,localhost,stratum.example.com

# ---- OBSERVABILITY / LOGGING ----
# `tracing` filter (structured logs are written to stderr; stdout is reserved
# for the stdio JSON-RPC transport). Default: info.
#RUST_LOG=info
#RUST_LOG=mcp=debug

# ---- NO-AUTH FORCE (optional) ----
# Presence disables PAT auth even if a token is set. Mostly for testing.
#PKM_MCP_NO_AUTH=1

# ---- HEALTH PROBE (container HEALTHCHECK only; not secret) ----
# `--health-probe` resolves the vault from PKM_MCP_VAULT; nothing else needed.
