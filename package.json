{
  "name": "stratum-ui",
  "private": true,
  "license": "AGPL-3.0-only",
  "version": "1.0.0-beta.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "knip": "knip",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:real": "node e2e/real/test.mjs",
    "test:e2e:harness": "node e2e/harness/bin/run.mjs",
    "tauri": "tauri",
    "tauri:dev": "WEBKIT_DISABLE_DMABUF_RENDERER=1 WEBKIT_DISABLE_COMPOSITING_MODE=1 tauri dev",
    "tauri:dev:x11": "WEBKIT_DISABLE_DMABUF_RENDERER=1 WEBKIT_DISABLE_COMPOSITING_MODE=1 GDK_BACKEND=x11 tauri dev",
    "tauri:android:build": "cargo tauri android build --target aarch64 --apk",
    "tauri:android:dev": "cargo tauri android dev",
    "tauri:android:dev:x86": "cargo tauri android dev --target x86_64",
    "tauri:build": "WEBKIT_DISABLE_DMABUF_RENDERER=1 WEBKIT_DISABLE_COMPOSITING_MODE=1 tauri build",
    "tauri:ios:build": "cargo tauri ios build",
    "tauri:ios:dev": "cargo tauri ios dev"
  },
  "dependencies": {
    "@blocknote/core": "^0.56.0",
    "@blocknote/mantine": "^0.56.0",
    "@blocknote/react": "^0.56.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource/inter": "^5.3.0",
    "@mui/icons-material": "^9.5.0",
    "@mui/material": "^9.2.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "dompurify": "^3.4.17",
    "i18next": "^26.5.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "katex": "^0.19.0",
    "mermaid": "^12.2.0",
    "prosemirror-model": "1.25.12",
    "prosemirror-state": "1.4.4",
    "prosemirror-view": "1.42.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-force-graph-2d": "^1.29.2",
    "react-force-graph-3d": "^1.29.2",
    "react-i18next": "^17.1.0",
    "react-router-dom": "^7.18.0",
    "shiki": "^4.5.0",
    "three-spritetext": "^1.10.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.12.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "d3-force-3d": "^3.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "knip": "^6.42.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.0",
