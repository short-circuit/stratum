{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-hide",
    "dialog:default",
    "dialog:allow-open",
    "global-shortcut:default",
    "notification:default",
    "opener:default"
  ]
}
